# Combat-Skill-Head Inference-Test — lädt das trainierte Modell und macht
# eine top-k Vorhersage für ein hand-craftedes test-input.
#
# Sanity-Check: Bei input "magic_aptitude fire sword" sollten Skills aus
# magic_aptitude foundation (Combat-Magic) hoch scoren, idealerweise mit
# fire-Element-Affinität.

- import: "prophecy/sources/embedding.aiml"
- import: "prophecy/sources/heads.aiml"
- import: "prophecy/sources/corpus_loader.aiml"
- import: "sources/shared/skill.aiml"

- class:
    name: CombatSkillTest
    members:
      - [embedder,     ptr<TagEmbedding>, null]   # Eigentuemer; BagBackbone leiht sich ihn als ref
      - [atlas_kv,     Kv<string:TagAtlasEntry>]
      - [hidden_dim,   i32, 64]
      - [backbone,     BagBackbone]
      - [head,         SoftmaxOutputHead]
      - [skill_vocab,  list<string>]
      - [current_priority, list<string>]

    methods:
      - def:
          name: decode_vocab_blob
          args: [[blob, string]]
          return: list<string>
          body:
            - decl: [out, list<string>]
            - if: { condition: { eq: [blob.len, 0] }, then: [{ return: out }] }
            - decl: [parts, list<string>, { call: [blob.split, "|"] }]
            - decl: [n_p, i32, parts.len]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, n_p] }
                body:
                  - decl: [raw, string, { at: [parts, idx] }]
                  - call: [out.push, { call: [raw.trim] }]
                  - set: [idx, { "+": [idx, 1] }]
            - return: out

      - def:
          name: resolve_token
          args: [[tok_str, string]]
          return: string
          body:
            - decl: [n_prio, i32, <.current_priority.len]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, n_prio] }
                body:
                  - decl: [dom, string, { at: [<.current_priority, idx] }]
                  - decl: [k_tag, string, "tag:${dom}:${tok_str}"]
                  - if: { condition: { eq: [{ call: [<.atlas_kv.has, k_tag] }, 1] }, then: [{ return: k_tag }] }
                  - decl: [k_name, string, "name:${dom}:${tok_str}"]
                  - if: { condition: { eq: [{ call: [<.atlas_kv.has, k_name] }, 1] }, then: [{ return: k_name }] }
                  - decl: [k_adj, string, "adj:${dom}:${tok_str}"]
                  - if: { condition: { eq: [{ call: [<.atlas_kv.has, k_adj] }, 1] }, then: [{ return: k_adj }] }
                  - set: [idx, { "+": [idx, 1] }]
            - return: ""

      - def:
          name: tokenize_bag
          args: [[input_str, string]]
          return: list<i32>
          body:
            - decl: [out, list<i32>]
            - decl: [toks, list<string>, { call: [input_str.split, " "] }]
            - decl: [n_t, i32, toks.len]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, n_t] }
                body:
                  - decl: [raw, string, { at: [toks, idx] }]
                  - decl: [tok, string, { call: [raw.trim] }]
                  - if:
                      condition: { gt: [tok.len, 0] }
                      then:
                        - decl: [key, string, { call: [<.resolve_token, tok] }]
                        - if:
                            condition: { eq: [key.len, 0] }
                            then: [{ call: [log.warn, "  '${tok}' UNRESOLVED in atlas"] }]
                            else:
                              - if:
                                  condition: { eq: [{ call: [<.embedder.vocab_index.contains, key] }, 1] }
                                  then:
                                    - decl: [tid, i32, { call: [<.embedder.vocab_index.get, key] }]
                                    - call: [out.push, tid]
                                    - call: [log.info, "  '${tok}' → '${key}' (id=${tid})"]
                                  else: [{ call: [log.warn, "  '${tok}' → '${key}' NOT in vocab_index"] }]
                  - set: [idx, { "+": [idx, 1] }]
            - return: out

      - def:
          name: print_top_k
          args: [[input_str, string], [k_count, i32]]
          body:
            - call: [log.info, ""]
            - call: [log.info, "══ Combat-Skill Prediction ══"]
            - call: [log.info, "  input: '${input_str}'"]
            - decl: [ids, list<i32>, { call: [<.tokenize_bag, input_str] }]
            - call: [log.info, "  resolved ${ids.len} tokens"]
            - if:
                condition: { eq: [ids.len, 0] }
                then:
                  - call: [log.error, "  no tokens — abort"]
                  - return: 0
            - decl: [hidden, tensor, { call: [<.backbone.encode_bag, ids] }]
            - decl: [logits, tensor, { call: [<.head.forward_logits, hidden] }]
            - decl: [probs, tensor, { call: [tensor.softmax, logits, 1] }]
            - decl: [n_out, i32, <.skill_vocab.len]
            - decl: [picked, list<i32>]
            - decl: [k_iter, i32, 0]
            - while:
                condition: { lt: [k_iter, k_count] }
                body:
                  - decl: [best_idx, i32, -1]
                  - decl: [best_v, f32, -1.0]
                  - decl: [i_idx, i32, 0]
                  - while:
                      condition: { lt: [i_idx, n_out] }
                      body:
                        - decl: [is_used, i32, 0]
                        - decl: [u_idx, i32, 0]
                        - while:
                            condition: { lt: [u_idx, picked.len] }
                            body:
                              - if: { condition: { eq: [{ at: [picked, u_idx] }, i_idx] }, then: [{ set: [is_used, 1] }] }
                              - set: [u_idx, { "+": [u_idx, 1] }]
                        - if:
                            condition: { eq: [is_used, 0] }
                            then:
                              - decl: [val, f32, { call: [probs.get, i_idx] }]
                              - if:
                                  condition: { gt: [val, best_v] }
                                  then:
                                    - set: [best_v, val]
                                    - set: [best_idx, i_idx]
                        - set: [i_idx, { "+": [i_idx, 1] }]
                  - if:
                      condition: { ge: [best_idx, 0] }
                      then:
                        - call: [picked.push, best_idx]
                        - decl: [sk_name, string, { at: [<.skill_vocab, best_idx] }]
                        - decl: [rank, i32, { "+": [k_iter, 1] }]
                        - call: [log.info, "  ${rank}. ${sk_name}  (p=${best_v})"]
                  - set: [k_iter, { "+": [k_iter, 1] }]

      - def:
          name: setup
          args: []
          return: i32
          body:
            - call: [log.info, "loading foundation embedder…"]
            # Move-only-Model: ein Wert-Member traegt die Tensoren nicht mit
            # (foundation.emb war NULL).  Eigentuemer anlegen, Backbone leiht.
            - set: [<.embedder, { new: TagEmbedding }]
            - decl: [ok_load, i32, { call: [<.embedder.load_vocab] }]
            - if:
                condition: { neq: [ok_load, 1] }
                then:
                  - call: [log.error, "vocab load failed — run prophecy_build + pretrain first"]
                  - return: 0
            - call: [<.embedder.init_model]
            - call: [log.info, "  embedder: ${<.embedder.n_tokens} tokens × d=${<.embedder.d_embed}"]
            - set: [<.atlas_kv, { call: [db.open_kv, prophecy_atlas_name, {persist: true}] }]
            - set: [<.backbone.foundation, <.embedder]
            - set: [<.backbone.hidden_dim, <.hidden_dim]
            - set: [<.backbone.weights_name, "prophecy_combat_skill_head_body"]
            - call: [<.backbone.init_model]
            - decl: [v_kv, Kv<string:string>, { call: [db.open_kv, "prophecy_combat_skill_vocab", {persist: true}] }]
            - decl: [blob, string, { call: [v_kv.get, "skills"] }]
            - set: [<.skill_vocab, { call: [<.decode_vocab_blob, blob] }]
            - call: [log.info, "  skill_vocab: ${<.skill_vocab.len} skills"]
            - set: [<.head.weights_name, "prophecy_combat_skill_head_outputs"]
            - set: [<.head.head_id_str, "combat_skill"]
            - set: [<.head.n_outputs_val, <.skill_vocab.len]
            - call: [<.head.init_params, <.hidden_dim]
            # Broad priority — match what the train trainer uses
            - call: [<.current_priority.push, "skills:base_skills"]
            - call: [<.current_priority.push, "skills:combat_skills"]
            - call: [<.current_priority.push, "skills:combat_skill_tags"]
            - call: [<.current_priority.push, "cross:element"]
            - call: [<.current_priority.push, "items:weapon"]
            - call: [<.current_priority.push, "items:tool"]
            - call: [<.current_priority.push, "items:device"]
            - call: [<.current_priority.push, "items:utility"]
            - call: [<.current_priority.push, "items:rune"]
            - call: [<.current_priority.push, "items:amulet"]
            - call: [<.current_priority.push, "items:ring"]
            - call: [<.current_priority.push, "items:socketable"]
            - call: [<.current_priority.push, "items:starter_items"]
            - call: [<.current_priority.push, "actions:base_actions"]
            - call: [<.current_priority.push, "synthetic:cluster_extras"]
            - return: 1

      - def:
          name: run
          args: []
          body:
            - decl: [setup_ok, i32, { call: [<.setup] }]
            - if: { condition: { neq: [setup_ok, 1] }, then: [{ return: 0 }] }
            # Original-Frage: magic_aptitude + fire + sword
            - call: [<.print_top_k, "magic_aptitude fire sword", 10]
            # Mit starter focus_breath als realistic player context
            - call: [<.print_top_k, "magic_aptitude focus_breath fire staff", 10]
            # Smith → Krieger
            - call: [<.print_top_k, "smith_touch resource_lore sword", 10]
            - call: [<.print_top_k, "smith_touch axe aggressive", 10]
            # Tracking → Bogenschütze
            - call: [<.print_top_k, "tracking navigation bow", 10]
            # Animal sense → Beast skills
            - call: [<.print_top_k, "animal_sense tracking claw-blade", 10]
            # Crystal affinity → Tech
            - call: [<.print_top_k, "crystal_affinity resource_lore scanner", 10]
            # Rune sense → Arcane
            - call: [<.print_top_k, "rune_sense focus_breath staff", 10]

