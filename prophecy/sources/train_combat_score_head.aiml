# Einstiegspunkt.  Die Klasse CombatScoreHeadTrainer liegt in train_combat_score_head_app.aiml, damit `main`
# ein Modul von ausserhalb komponiert (spec/49 §15) statt alles selbst zu tragen.

- import: "prophecy/sources/train_combat_score_head_app.aiml"

- def:
    name: main
    args: []
    return: i32
    body:
      - decl: [trainer, ptr<CombatScoreHeadTrainer>, { new: CombatScoreHeadTrainer }]
      - call: [trainer.run]
      - return: 0
