# Einstiegspunkt.  Die Klasse CombatSkillTest liegt in combat_skill_test_app.aiml, damit `main`
# ein Modul von ausserhalb komponiert (spec/49 §15) statt alles selbst zu tragen.

- import: "prophecy/sources/combat_skill_test_app.aiml"

- def:
    name: main
    args: []
    return: i32
    body:
      - decl: [tester, ptr<CombatSkillTest>, { new: CombatSkillTest }]
      - call: [tester.run]
      - return: 0
