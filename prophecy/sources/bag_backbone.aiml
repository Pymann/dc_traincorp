# BagBackbone — geteilter Eingabe-Encoder (bag-of-tags → hidden vec).
# Ein Task-Modul instanziiert genau einen davon, unabhaengig von den Heads.
# Abgetrennt aus heads.aiml wegen der Drei-Typen-Grenze (spec/49 §14).

- import: "prophecy/sources/embedding.aiml"
- import: "prophecy/sources/head_tensors.aiml"

# ── BagBackbone — shared MLP body (bag → mean-pool → hidden) ─────────────────
# Per-task module instantiates one of these. Independent from any specific
# OutputHead set.
- class:
    name: BagBackbone
    members:
      - [weights_name,  string, "prophecy_head_body"]
      - [foundation,    ref<TagEmbedding>]
      - [hidden_dim,    i32, 64]
      - [weight_1,      tensor]    # d_embed × hidden_dim
      - [bias_1,        tensor]    # hidden_dim
    methods:
      - def:
          name: init_model
          args: []
          return: i32
          body:
            - if:
                condition: { lt: [<.foundation.n_tokens, 1] }
                then:
                  - call: [log.error, "BagBackbone: foundation not loaded"]
                  - return: 0
            - set: [<.weight_1, { call: [head_load_or_randn_2d, <.weights_name, "weight_1", <.foundation.d_embed, <.hidden_dim, 0.3] }]
            - set: [<.bias_1,   { call: [head_load_or_zeros_1d, <.weights_name, "bias_1",   <.hidden_dim] }]
            - call: [<.weight_1.set_requires_grad, 1]
            - call: [<.bias_1.set_requires_grad, 1]
            - return: 1

      - def:
          name: save_weights
          args: []
          body:
            - call: [tensor.save, <.weight_1, <.weights_name, "weight_1"]
            - call: [tensor.save, <.bias_1,   <.weights_name, "bias_1"]

      # Encode bag_ids → hidden (1×hidden_dim). Uses foundation.emb as shared
      # embedding. Builds bag mean-pool tensor on the fly.
      - def:
          name: encode_bag
          args: [[bag_ids, list<i32>]]
          return: tensor
          body:
            - decl: [n_ids, i32, bag_ids.len]
            - decl: [n_f,   f32, n_ids]
            - decl: [inv_n, f32, { "/": [1.0, n_f] }]
            - decl: [bag,   tensor, { call: [tensor.zeros, 1, <.foundation.n_tokens] }]
            - decl: [idx,   i32, 0]
            - while:
                condition: { lt: [idx, n_ids] }
                body:
                  - decl: [tid, i32, { at: [bag_ids, idx] }]
                  - decl: [cur, f32, { call: [bag.get, tid] }]
                  - call: [bag.set, tid, { "+": [cur, inv_n] }]
                  - set: [idx, { "+": [idx, 1] }]
            - decl: [mean_e, tensor, { call: [tensor.matmul, bag, <.foundation.emb] }]
            - decl: [h1_tn,     tensor, { call: [tensor.matmul, mean_e, <.weight_1] }]
            - decl: [h1b_tn,    tensor, { call: [tensor.add, h1_tn, <.bias_1] }]
            - decl: [h1r_tn,    tensor, { call: [tensor.relu, h1b_tn] }]
            - return: h1r_tn
