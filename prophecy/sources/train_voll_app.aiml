# Training ueber ALLE VIER Aufgaben -- der Kern der Spec (§3).
#
# Heute lernt jeder Kopf Tag-Bedeutungen getrennt, aus 1208 bis 25000 Folgen,
# und gemessen traegt keiner davon (prophecy_verstehen: 23 % bei einem Tag
# weniger, unter den 32 % einer trivialen Mengenregel).  Hier lernt EIN Modell
# sie einmal aus allen Korpora.
#
# Die Epochenzahl ist NICHT am Verlust gewaehlt: gemessen am 14.11. brachten
# 23 % weniger Verlust (30 statt 60 Epochen) den Faktor 3,6 WENIGER gueltige
# Vielfalt.  Darum wird nach JEDER Epoche gesichert, und abgebrochen wird nach
# einer Messung mit prophecy_gueltig -- nicht nach einer vorher geratenen Zahl.
- import: "prophecy/sources/transformer.aiml"
- import: "prophecy/sources/trainingsdaten.aiml"
- import: "prophecy/sources/zufall.aiml"

- def:
    name: main
    args: []
    return: i32
    body:
      - decl: [fge, ptr<Folge>, { new: Folge }]
      - decl: [bereit, i32, { call: [fge.init] }]
      - if:
          condition: { neq: [bereit, 1] }
          then:
            - call: [log.error, "voll: Wortschatz nicht ladbar"]
            - return: 1
      - decl: [n_wort, i32, { call: [fge.gesamt_tokens] }]

      - decl: [dat, ptr<Trainingsdaten>, { new: Trainingsdaten }]
      - call: [log.info, "voll: Korpora kodieren"]
      - call: [dat.lade, fge, "itemgen/data/items_augmented.txt", 0]
      - call: [dat.lade, fge, "discovergen/data/discoveries_augmented.txt", 1]
      - call: [dat.lade, fge, "data/skill_corpus.txt", 2]
      - call: [dat.lade, fge, "data/combat_skill_corpus.txt", 3]
      - decl: [n_folgen, i32, { call: [dat.zahl] }]
      - decl: [n_tok, i32, { call: [dat.tokens] }]
      - if:
          condition: { eq: [n_folgen, 0] }
          then:
            - call: [log.error, "voll: keine Folgen"]
            - return: 1
      - call: [log.info, "voll: ${n_folgen} Folgen, ${n_tok} Tokens, ${dat.zu_lang} wegen Laenge verworfen"]

      - decl: [mdl, ptr<RezeptModell>, { new: RezeptModell }]
      - call: [mdl.init, n_wort]
      - decl: [wrf, ptr<Zufall>, { new: Zufall }]
      - decl: [reihe, list<i32>]
      - decl: [rdx, i32, 0]
      - while:
          condition: { lt: [rdx, n_folgen] }
          body:
            - call: [reihe.push, rdx]
            - set: [rdx, { "+": [rdx, 1] }]

      - decl: [lr_ziel, f32, 0.0003]
      - decl: [n_epochen, i32, 12]
      - decl: [epoche, i32, 0]
      - while:
          condition: { lt: [epoche, n_epochen] }
          body:
            - decl: [t_start, i64, { call: [time.now] }]
            - decl: [lr_epoche, f32, lr_ziel]
            - decl: [edx, i32, 0]
            - while:
                condition: { lt: [edx, epoche] }
                body:
                  - set: [lr_epoche, { "*": [lr_epoche, 0.8] }]
                  - set: [edx, { "+": [edx, 1] }]
            - call: [wrf.setze, { cast: [{ "+": [epoche, 1] }, i64] }]
            - decl: [mdx, i32, { "-": [n_folgen, 1] }]
            - while:
                condition: { gt: [mdx, 0] }
                body:
                  - decl: [jdx, i32, { call: [wrf.ganzzahl, { "+": [mdx, 1] }] }]
                  - decl: [a_wert, i32, { at: [reihe, mdx] }]
                  - decl: [b_wert, i32, { at: [reihe, jdx] }]
                  - idx: [reihe, mdx, b_wert]
                  - idx: [reihe, jdx, a_wert]
                  - set: [mdx, { "-": [mdx, 1] }]
            - decl: [summe, f32, 0.0]
            - decl: [gezaehlt, i32, 0]
            - decl: [sdx, i32, 0]
            - while:
                condition: { lt: [sdx, n_folgen] }
                body:
                  - decl: [wahl, i32, { at: [reihe, sdx] }]
                  - decl: [beg, i32, { call: [dat.start_von, wahl] }]
                  - decl: [lng, i32, { call: [dat.laenge_von, wahl] }]
                  - decl: [npos, i32, { "-": [lng, 1] }]
                  - decl: [lrn, f32, lr_epoche]
                  - if:
                      condition: { eq: [epoche, 0] }
                      then:
                        - decl: [anteil, f32, { "/": [{ cast: [{ "+": [sdx, 1] }, f32] }, { cast: [n_folgen, f32] }] }]
                        - set: [lrn, { "*": [lr_epoche, anteil] }]
                  - call: [tensor.begin_graph]
                  - decl: [ein_t, tensor, { call: [tensor.zeros, npos] }]
                  - decl: [soll_t, tensor, { call: [tensor.zeros, npos] }]
                  - decl: [pdx, i32, 0]
                  - while:
                      condition: { lt: [pdx, npos] }
                      body:
                        - decl: [tin, i32, { call: [dat.token_bei, { "+": [beg, pdx] }] }]
                        - decl: [tso, i32, { call: [dat.token_bei, { "+": [{ "+": [beg, pdx] }, 1] }] }]
                        - call: [ein_t.set, pdx, { cast: [tin, f32] }]
                        - call: [soll_t.set, pdx, { cast: [tso, f32] }]
                        - set: [pdx, { "+": [pdx, 1] }]
                  - decl: [logits, tensor, { call: [mdl.vorwaerts, ein_t, npos] }]
                  - decl: [verlust, tensor, { call: [tensor.cross_entropy, logits, soll_t, npos] }]
                  - call: [tensor.backward, verlust]
                  - call: [mdl.schritt, lrn]
                  - set: [summe, { "+": [summe, { call: [verlust.item] }] }]
                  - set: [gezaehlt, { "+": [gezaehlt, 1] }]
                  - if:
                      condition: { eq: [{ "%": [sdx, 10000] }, 0] }
                      then:
                        - decl: [zw_f, f32, { cast: [gezaehlt, f32] }]
                        - decl: [zwi, f32, { "/": [summe, zw_f] }]
                        - call: [log.info, "  epoche ${epoche} bei ${sdx}/${n_folgen}, Verlust ${zwi}"]
                  - set: [sdx, { "+": [sdx, 1] }]
            - decl: [t_ende, i64, { call: [time.now] }]
            - decl: [dauer_ms, i64, { "-": [t_ende, t_start] }]
            - decl: [gz_f, f32, { cast: [gezaehlt, f32] }]
            - decl: [mittel, f32, { "/": [summe, gz_f] }]
            # Nach JEDER Epoche sichern: ein Abbruch soll nicht alles kosten.
            - call: [mdl.sichern]
            - call: [log.info, "epoche ${epoche}: Verlust ${mittel}, lr ${lr_epoche}, ${gezaehlt} Folgen, ${dauer_ms} ms — gesichert"]
            - set: [epoche, { "+": [epoche, 1] }]
      - call: [log.info, "voll: Training fertig"]
      - return: 0
