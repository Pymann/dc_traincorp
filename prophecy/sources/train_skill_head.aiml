# Einstiegspunkt.  Die Klasse SkillHeadTrainer liegt in train_skill_head_app.aiml, damit `main`
# ein Modul von ausserhalb komponiert (spec/49 §15) statt alles selbst zu tragen.

- import: "prophecy/sources/train_skill_head_app.aiml"

- def:
    name: main
    args: []
    return: i32
    body:
      - decl: [trainer, ptr<SkillHeadTrainer>, { new: SkillHeadTrainer }]
      - call: [trainer.run]
      - return: 0
