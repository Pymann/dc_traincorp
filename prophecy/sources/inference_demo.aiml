# Einstiegspunkt.  Die Klasse InferenceDemo liegt in inference_demo_app.aiml, damit `main`
# ein Modul von ausserhalb komponiert (spec/49 §15) statt alles selbst zu tragen.

- import: "prophecy/sources/inference_demo_app.aiml"

- def:
    name: main
    args: []
    return: i32
    body:
      - decl: [demo, ptr<InferenceDemo>, { new: InferenceDemo }]
      - call: [demo.run]
      - return: 0
