          "guild"
        ],
        "difficulty": 2,
        "max_harvests": 5,
        "harvest_count": 0
      }
    },
    {
      "geber_id": "npc_guild_vice_moland",
      "lohn_hashes": 0,
      "lohn_bytes": 0,
      "lohn_items": [],
      "lohn_skill_id": "shard_walker",
      "lohn_skill_name": "Shard-Walker",
