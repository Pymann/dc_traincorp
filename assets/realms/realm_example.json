        "attr.will": 1.0
      },
      "lohn_wearable": 1
    },
    {
      "geber_id": "npc_guild_vice_moland",
      "lohn_hashes": 0,
      "lohn_bytes": 0,
      "lohn_items": [],
      "lohn_skill_id": "",
      "lohn_skill_name": "",
      "lohn_wirkungen": {},
      "lohn_wearable": 1,
      "ziel_zahl": 3,
      "quest_id": "quest_guild_medicine",
      "art": 3,
      "titel": "Heilkraeuter fuer Neri",
      "text": "Unsere Botin Neri liegt mit Scherbenfieber im Krankenquartier. Die Heiler brauchen drei Sternblattkraeuter fuer ihre spezielle Medizin. Nimm den Auftrag an und reise von Green Span zur Coherence Farm im Shard-Garden. Von Rim Market gelangst du ohne besondere Fertigkeit ueber den Karawanenpfad nach Green Span. Auf der Farm erscheint fuer dich Neris Sternblatt-Beet. Klicke es an und sammle im Ernte-Minispiel die Kraeuter; du brauchst kein Werkzeug. Treffer bringen Ertrag, und du darfst es bei Bedarf erneut versuchen. Bringe drei Kraeuter in eine der Gildenhallen zurueck. Du erhaeltst ein tragbares Ausruestungsstueck: Lege es vor dem naechsten Auftrag an.",
      "ziel_zone_id": "zone_coherence_farm",
      "ziel_id": "neri_sternblatt",
      "vorquest_id": "quest_wraith_five",
      "fund_stelle": {
        "harvestable_id": "quest_neri_herbs",
        "name": "Neris Sternblatt-Beet",
        "realm_id": "realm_shard_garden",
