    {
      "quest_id": "quest_wraith_five",
      "art": 2,
      "titel": "Five Shadows",
      "text": "Lerne die Wiesen von Green Span kennen: Entdecke dort Wraiths und besiege fuenf von ihnen. Im Kampf helfen der i-Knopf und die Grundaktionen: gehen, drehen, schlagen, ausweichen und abwehren. Nur Siege nach Annahme zaehlen. Kehre danach zu Moland oder Ruun in eine der Gildenhallen zurueck. Die Gilde belohnt dich mit Guild Resolve und einem tragbaren Ausruestungsstueck.",
      "geber_id": "npc_guild_vice_moland",
      "ziel_zone_id": "",
      "ziel_id": "wraith",
      "ziel_zahl": 5,
      "lohn_hashes": 0,
      "lohn_bytes": 0,
      "lohn_items": [],
      "lohn_skill_id": "guild_resolve",
      "lohn_skill_name": "Guild Resolve",
